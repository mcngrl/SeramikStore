@using SeramikStore.Services.DTOs
@using Microsoft.Extensions.Localization
@using SeramikStore.Web.Localization
@model List<UserDto>
@inject IStringLocalizer<AccountResource> L

@{
    ViewData["Title"] = "Müþteri Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mt-3 d-flex gap-2">
    <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-primary">
        <i class="bi bi-arrow-clockwise me-1"></i> Yenile
    </a>
</div>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h6 class="mb-4 d-flex align-items-center gap-2">
                <i class="fa-solid fa-users me-1"></i>
                Müþteri Listesi
            </h6>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Kayýtlý müþteri bulunmamaktadýr.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 15%">Ad</th>
                                <th style="width: 15%">Soyadý</th>
                                <th style="width: 25%">E-posta</th>
                                <th style="width: 15%">Telefon</th>
                                <th style="width: 15%">Durum</th>
                                <th style="width: 10%">Ýþlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@customer.Id</span>
                                    </td>
                                    <td>
                                        <strong>@customer.FirstName</strong>
                                    </td>
                                    <td>
                                        @customer.LastName
                                    </td>
                                    <td>
                                        <a href="mailto:@customer.Email">@customer.Email</a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.PhoneNumber))
                                        {
                                            <a href="tel:@customer.PhoneNumber">@customer.PhoneNumber</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i> Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i> Pasif
                                            </span>
                                        }
                                        @if (!customer.IsEmailConfirmed)
                                        {
                                            <span class="badge bg-warning ms-1">
                                                <i class="bi bi-exclamation-circle me-1"></i> Onaylanmamýþ
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" 
                                                    class="btn btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#customerDetailModal"
                                                    onclick="loadCustomerDetail(@customer.Id)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Müþteri Detay Modal -->
<div class="modal fade" id="customerDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Müþteri Detaylarý</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="customerDetailContent">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadCustomerDetail(customerId) {
            // Modal içeriði yükleme
            const content = document.getElementById('customerDetailContent');
            const customer = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FirstOrDefault()));

            // Basit bir detay gösterimi
            if (customerId) {
                fetch(`/Admin/GetCustomerDetail?id=${customerId}`)
                    .then(response => response.text())
                    .then(html => {
                        content.innerHTML = html;
                    })
                    .catch(error => {
                        content.innerHTML = '<div class="alert alert-danger">Müþteri bilgisi yüklenemedi.</div>';
                    });
            }
        }
    </script>
}